FROM python:3.13-slim

WORKDIR /app

RUN pip install uv

# The lockfile comes too, so --frozen installs the versions the repo pins rather than re-resolving.
COPY backend/pyproject.toml backend/uv.lock ./

RUN uv sync --no-dev --frozen

COPY backend/ .

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
